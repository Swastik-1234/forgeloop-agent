# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://likeable:likeable@localhost:5434/likeable

# ── Auth ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ── LLM (Groq — free tier, OpenAI-compatible) ────────────
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Must be a Groq model that supports tool calling. gpt-oss-120b is more
# capable but its free tier only allows 8000 tokens/min — 20b runs the
# full agent loop without hitting that limit as quickly.
GROQ_MODEL=openai/gpt-oss-20b

# ── E2B sandboxes (required to actually run the agent) ───
# Sign up at https://e2b.dev — free trial credits available.
# You must also build the custom template once, see README:
#   pnpm --filter agent build-template
E2B_API_KEY=
E2B_TEMPLATE_ALIAS=likeable-react-base

# ── Exa web search (optional) ────────────────────────────
# Get a key at https://exa.ai — if left empty, the agent's
# search tool degrades gracefully and just skips web search.
EXASEARCH_API_KEY=

# ── Server ────────────────────────────────────────────────
PORT=3010
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
